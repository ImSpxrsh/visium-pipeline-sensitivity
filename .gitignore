# macOS
.DS_Store
*.swp

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/

# Environments
venv/
env/
.venv/

# squidpy / scanpy cache
.cache/

# Data (large, reproducible from code / re-downloadable via squidpy)
data/raw/*.h5ad
data/processed/*.h5ad
data/anndata/
data/images/
data/visium/
data/**/tmp*

# Results: keep large per-spec runs and logs out of git, but DO track the
# small aggregate tables and publication figures (reproducible paper artifacts).
# The pattern covers secondary-dataset namespaces too (results/<dataset>/runs).
results/runs/
results/logs/
results/**/runs/
results/**/logs/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/

# Slurm job logs
logs/
