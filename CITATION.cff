    given-names: "Sparsh"
    alias: "ImSpxrsh"
repository-code: "https://github.com/ImSpxrsh/Spatial-Transcriptomics"
keywords:
  - spatial transcriptomics
  - multiverse analysis
  - specification curve
  - reproducibility
  - Visium
